#!/bin/bash
set -euo pipefail
profile=${BAZZITE_LAB_PROFILE:?Launch a Wayland Lab session first}
case "$profile" in niri-*|hyprland-*|kineticwe-*) ;; *) exit 2 ;; esac
export XDG_CONFIG_HOME="${BAZZITE_LAB_CONFIG_ROOT:?}/$profile"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/bazzite-lab/$profile"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
case "$profile" in
    *-dms) exec dms run ;;
    *-noctalia) exec noctalia ;;
    kineticwe-native) exec /usr/lib/kineticwe/bin/noctalia-kwe ;;
    *-minimal)
        mkdir -p "$XDG_CONFIG_HOME/waybar"
        [[ -f "$XDG_CONFIG_HOME/waybar/config.jsonc" ]] || cp /usr/share/bazzite-lab/waybar/config.jsonc "$XDG_CONFIG_HOME/waybar/config.jsonc"
        [[ -f "$XDG_CONFIG_HOME/waybar/style.css" ]] || cp /usr/share/bazzite-lab/waybar/style.css "$XDG_CONFIG_HOME/waybar/style.css"
        mako &
        notifier=$!
        /usr/libexec/polkit-gnome-authentication-agent-1 &
        agent=$!
        trap 'kill "$notifier" "$agent" "${bar:-}" 2>/dev/null || true' EXIT
        trap 'exit 0' TERM INT HUP
        waybar &
        bar=$!
        wait "$bar"
        ;;
    *) exit 2 ;;
esac
